# SeaScope Landing — Variables d'environnement
# Copier en .env.local pour le développement

# Brevo — envoi d'emails transactionnels
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER=seascope-contact@pennarstudio.fr
BREVO_SENDER_NAME=SeaScope

# Email de notification (destinataire des leads)
OWNER_EMAIL=seascope-contact@pennarstudio.fr

# Notion — stockage des données de formulaire
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BETA_DB_ID=dfd1e279aed940879b00d3763a4e7ea7
NOTION_FEEDBACK_DB_ID=f0b96a9c2d4d47b8b4e1c9f204693336

# CORS — origines autorisées (séparées par virgules, optionnel)
# ALLOWED_ORIGINS=https://seascope.app,https://www.seascope.app

# Backoffice admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Lien d'opt-in du test fermé Google Play
GOOGLE_PLAY_URL=
# Lien public du formulaire Notion « Retour d'expérience »
FEEDBACK_FORM_URL=
